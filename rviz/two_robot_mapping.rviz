      Enabled: true
      Length: 0.8
      Name: R0 Ground-Fused Base Axes
      Radius: 0.045
      Reference Frame: r0/base_link
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.8
      Name: R1 Ground-Fused Base Axes
      Radius: 0.045
      Reference Frame: r1/base_link
      Value: true
    - Alpha: 0.92
      Autocompute Intensity Bounds: false
      Autocompute Value Bounds:
        Max Value: 1
        Min Value: 0
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 45; 160; 255
      Color Transformer: FlatColor
      Decay Time: 0.15
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 1
