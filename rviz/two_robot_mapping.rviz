      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: true
      Use Timestamp: false
      Value: false
    - Alpha: 0.28
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: false
      Name: R0 Local Occupancy (debug)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /toy_record/r0/local_occupancy
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: true
      Use Timestamp: false
      Value: false
    - Alpha: 0.28
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: false
      Enabled: false
      Name: R1 Local Occupancy (debug)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /toy_record/r1/local_occupancy
      Update Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: true
      Use Timestamp: false
      Value: false
    - Angle Tolerance: 0.05
      Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation:
          Alpha: 0.35
          Color: 70; 180; 255
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: true
        Position:
          Alpha: 0.25
          Color: 70; 180; 255
          Scale: 1
          Value: true
        Value: true
      Enabled: true
      Keep: 500
      Name: R0 Final Ground-Fused Odometry
      Position Tolerance: 0.03
      Shape:
        Alpha: 1
        Axes Length: 0.55
        Axes Radius: 0.04
        Color: 45; 160; 255
        Head Length: 0.22
        Head Radius: 0.08
        Shaft Length: 0.65
        Shaft Radius: 0.035
        Value: Arrow
      Topic:
        Depth: 50
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /toy_record/r0/odom
      Value: true
    - Angle Tolerance: 0.05
      Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation:
          Alpha: 0.35
          Color: 255; 160; 50
          Color Style: Unique
          Frame: Local
          Offset: 1
          Scale: 1
          Value: true
        Position:
          Alpha: 0.25
          Color: 255; 160; 50
          Scale: 1
          Value: true
        Value: true
      Enabled: true
      Keep: 500
      Name: R1 Final Ground-Fused Odometry
      Position Tolerance: 0.03
      Shape:
        Alpha: 1
        Axes Length: 0.55
        Axes Radius: 0.04
        Color: 255; 130; 35
        Head Length: 0.22
        Head Radius: 0.08
        Shaft Length: 0.65
        Shaft Radius: 0.035
        Value: Arrow
      Topic:
        Depth: 50
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /toy_record/r1/odom
      Value: true
